generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Home {
  id             Int      @id @default(autoincrement())
  slider1Url     String   @default("")
  slider2Url     String   @default("")
  slider3Url     String   @default("")
  textoEvento    String   @default("")
  youtubeUrl     String   @default("")
  // Stats del proyecto — editables desde backoffice, renderizados en trust bar + Quiénes Somos
  totalEdiciones Int      @default(0)
  totalShows     Int      @default(0)
  totalPersonas  Int      @default(0)
  // Defaults globales para los box "El Evento" en home pública. Son la línea
  // de fallback cuando el evento destacado no trae overrides propios.
  boxLugar           String @default("Espacio Doble T")
  boxDireccion       String @default("Calle 23 entre 43 y 44, Barrio La Loma")
  boxCiudad          String @default("La Plata")
  boxEtiquetaEntrada String @default("Anticipada online")
  // Cuántas tarjetas de "Próximos eventos" se ven a la vez en el carrusel de la
  // portada. No limita cuántos eventos existen (se muestran todos los publicados),
  // solo el ancho de la ventana visible. Editable desde el backoffice.
  eventosVisiblesPortada Int @default(3)
  // Toggle de la sección "El Evento" (#descripcion) = el pitch del ciclo semanal
  // Amor de Miércoles. Se apaga desde el backoffice cuando la agenda está armada
  // solo con eventos especiales (no hay ciclo del miércoles) para no confundir.
  // Default true = comportamiento histórico (siempre visible).
  mostrarCicloMiercoles Boolean @default(true)
  updatedAt      DateTime @updatedAt
  // Menú de Casa Metro (Sprint 7). El precio es GLOBAL y editable desde el
  // backoffice, pero cada Compra congela el suyo en `Compra.menuUnitario`: subirlo
  // acá NO reescribe la contabilidad de lo ya vendido.
  // `menuCorteHora` es la hora del día del evento después de la cual ya no se
  // vende menú (la cocina necesita cerrar la cuenta). Se crea acá y la consume
  // el corte horario — hoy no tiene lógica asociada.
  // ⚠️ Campos AL FINAL del modelo a propósito: así Prisma genera
  // `ALTER TABLE ADD COLUMN` en vez de reescribir la tabla entera.
  precioMenu     Int      @default(15000)
  menuCorteHora  String   @default("18:00")
  // Afiliaciones (escalón 0): los tres planes de suscripción de Mercado Pago que
  // muestra /afiliate. Los carga la coordinación desde el panel; el repo no lleva
  // ni montos ni links (defaults vacíos). Son públicos a propósito: los devuelve
  // `GET /api/home` y se ven en la página. Un plan se muestra si tiene nombre y
  // monto; el link sólo se acepta de Mercado Pago y por https
  // (src/services/planes-afiliacion.service.js). Al final del modelo, como los
  // del menú, para que la migración sea ADD COLUMN.
  afiliacionPlan1Nombre String @default("")
  afiliacionPlan1Monto  Int    @default(0)
  afiliacionPlan1Link   String @default("")
  afiliacionPlan2Nombre String @default("")
  afiliacionPlan2Monto  Int    @default(0)
  afiliacionPlan2Link   String @default("")
  afiliacionPlan3Nombre String @default("")
  afiliacionPlan3Monto  Int    @default(0)
  afiliacionPlan3Link   String @default("")
}

model Evento {
  id            Int               @id @default(autoincrement())
  nombre        String
  descripcion   String
  fecha         DateTime
  hora          String
  invitado      String            @default("")
  flyerUrl      String            @default("")
  esDestacado   Boolean           @default(false)
  estaPublicado Boolean           @default(false)
  estaAgotado   Boolean           @default(false)
  esExterno     Boolean           @default(false)
  linkExterno   String?
  // Overrides opcionales para los box "El Evento" en home pública. Si están
  // vacíos, el frontend cae a lo derivado del evento (fecha/hora/precio) o a
  // los defaults de Home (lugar/ciudad/etiquetaEntrada).
  boxDiaOverride             String @default("")
  boxFechaOverride           String @default("")
  boxHoraOverride            String @default("")
  boxLugarOverride           String @default("")
  boxDireccionOverride       String @default("")
  boxCiudadOverride          String @default("")
  boxPrecioOverride          String @default("")
  boxEtiquetaEntradaOverride String @default("")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  // Menú de Casa Metro (Sprint 7). Eje ORTOGONAL a `Compra.tipoEntrada`: el menú
  // es una cantidad propia, no un tipo de entrada ni un flag de la compra.
  // `menuHabilitado` false = el evento no ofrece menú (default: los eventos
  // preexistentes quedan como estaban). `topeMenus` null = sin tope; se crea acá
  // y lo consume la reserva atómica del tope — hoy no tiene lógica asociada.
  // ⚠️ Al final del modelo a propósito (ver nota en Home).
  menuHabilitado Boolean @default(false)
  topeMenus      Int?
  compras       Compra[]
  tandas        Tanda[]
  cupones       CuponDescuento[]
  reportTokens  ReportAccessToken[]
}

model Tanda {
  id               Int       @id @default(autoincrement())
  eventoId         Int
  evento           Evento    @relation(fields: [eventoId], references: [id])
  nombre           String
  precio           Int
  orden            Int
  activa           Boolean   @default(true)
  capacidad        Int?
  cantidadVendida  Int       @default(0)
  fechaLimite      DateTime?
  porcentajeAporte Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  compras          Compra[]

  @@unique([eventoId, orden])
}

model Compra {
  id                 Int         @id @default(autoincrement())
  eventoId           Int
  evento             Evento      @relation(fields: [eventoId], references: [id])
  tandaId            Int?
  tanda              Tanda?      @relation(fields: [tandaId], references: [id])
  email              String
  nombre             String
  apellido           String
  telefono           String      @default("")
  cantidadEntradas   Int
  precioUnitario     Int
  totalPagado        Int
  tipoEntrada        String      @default("base")
  excedenteUnitario  Int         @default(0)
  mpPreferenciaId    String      @default("")
  mpPagoId           String      @default("")
  mpEstado           String      @default("pending")
  // Devolución manual desde el backoffice (US-A): cuando Euge hace un refund en
  // Mercado Pago, el admin marca la compra como devuelta. mpEstado pasa a
  // 'refunded' y se registra quién/cuándo/por qué para trazabilidad contable.
  devueltaAt         DateTime?
  devueltaPor        String?
  devueltaMotivo     String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  // Menú de Casa Metro (Sprint 7). `cantidadMenus` es INDEPENDIENTE de
  // `cantidadEntradas` (con dos reglas duras: mínimo 1 entrada, y menús ≤
  // entradas). `menuUnitario` congela el `Home.precioMenu` vigente al comprar —
  // por eso la plata del menú se lee de la compra y no del precio global, que
  // puede haber cambiado después.
  // ⚠️ Al final del modelo a propósito (ver nota en Home): `Compra` es la tabla
  // de la plata y nunca fue reescrita en producción.
  cantidadMenus      Int         @default(0)
  menuUnitario       Int         @default(0)
  // Cuándo el mail con el QR no salió (Brevo lo rechazó o no se pudo armar). Se
  // limpia con un Reenviar que sale bien. Es lo que deja ver en Compras a quién
  // hay que reenviárselo: en la entrada incluida el mail es el único camino del QR.
  // ⚠️ Al final del modelo y con la migración escrita a mano (un ADD COLUMN).
  mailFallidoAt      DateTime?
  entradas           Entrada[]
  cuponUsos          CuponUso[]
}

model Entrada {
  id         Int       @id @default(autoincrement())
  compraId   Int
  compra     Compra    @relation(fields: [compraId], references: [id])
  codigoQR   String    @unique
  qrImageUrl String
  validada   Boolean   @default(false)
  validadaAt DateTime?
  createdAt  DateTime  @default(now())
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  apellido  String
  email     String   @unique
  telefono  String   @default("")
  password  String
  rol       Int      @default(2)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CuponDescuento {
  id            Int        @id @default(autoincrement())
  eventoId      Int
  evento        Evento     @relation(fields: [eventoId], references: [id])
  codigo        String     @unique
  tipo          String
  valor         Int
  topeUsos      Int?
  usosActuales  Int        @default(0)
  validoHasta   DateTime?
  activo        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  usos          CuponUso[]
  // Cupón de afiliados. `paraAfiliados` lo marca como beneficio de la afiliación
  // (lo lista la página de afiliados); `unaEntradaPorCompra` hace que sólo se
  // pueda usar en compras de UNA entrada. Sin esto el cupón descuenta todas las
  // entradas de la compra (`calcularTotalCompra`: precio unitario × cantidad).
  // La regla vive en `validarCupon`. Default false: los cupones existentes no
  // cambian.
  // ⚠️ Al final del modelo a propósito: la migración es ALTER TABLE ADD COLUMN,
  // escrita a mano (en SQLite `migrate dev` reescribe la tabla con DROP TABLE).
  paraAfiliados       Boolean    @default(false)
  unaEntradaPorCompra Boolean    @default(false)
}

model CuponUso {
  id                Int            @id @default(autoincrement())
  cuponId           Int
  cupon             CuponDescuento @relation(fields: [cuponId], references: [id])
  compraId          Int
  compra            Compra         @relation(fields: [compraId], references: [id])
  descuentoAplicado Int
  createdAt         DateTime       @default(now())

  @@unique([compraId])
}

// Token de acceso de solo-lectura a un Reporte de Ventas por Evento (#9).
// Habilita un link público (sin sesión) acotado a UN evento, con expiración
// obligatoria y revocable. Modela el mismo patrón que CuponDescuento (token
// @unique + activo + ventana de validez). El endpoint público que valida este
// token solo expone métricas AGREGADAS del evento — nunca PII de compradores.
model ReportAccessToken {
  id           Int       @id @default(autoincrement())
  eventoId     Int
  evento       Evento    @relation(fields: [eventoId], references: [id])
  token        String    @unique
  expiraEn     DateTime
  creadoPor    String    @default("")
  activo       Boolean   @default(true)
  ultimoAcceso DateTime?
  createdAt    DateTime  @default(now())

  @@index([eventoId])
}

// Token de acceso para VALIDAR ENTRADAS por QR en la puerta, pensado para
// compartir con una sede o colaborador externo (ej. personal de Casa Metro) sin
// darle el backoffice completo. A diferencia de ReportAccessToken: es GLOBAL (no
// atado a un evento — sirve para todos los ciclos), NO expira (se desactiva a
// voluntad con `activo`), y el endpoint que valida sí muestra el nombre del
// comprador (no datos de contacto). Un solo link compartido entre validadores.
model ValidationAccessToken {
  id           Int       @id @default(autoincrement())
  token        String    @unique
  descripcion  String    @default("")
  activo       Boolean   @default(true)
  creadoPor    String    @default("")
  ultimoAcceso DateTime?
  createdAt    DateTime  @default(now())
}

// Dirección privada de la página de afiliados (`/afiliados/<token>`). Es una
// capability URL: quien tiene el link entra, sin login. Se acepta porque la
// página es igual para todos y no muestra datos de nadie. Se ROTA una vez por mes
// desde el backoffice: generar una nueva da de baja las anteriores en la misma
// transacción (una sola activa a la vez), y así quien dejó de pagar pierde el
// acceso con el cambio. Mismo molde que ValidationAccessToken: global, sin
// vencimiento, se apaga con `activo`.
model AccesoAfiliados {
  id           Int       @id @default(autoincrement())
  token        String    @unique
  activo       Boolean   @default(true)
  creadoPor    String    @default("")
  ultimoAcceso DateTime?
  createdAt    DateTime  @default(now())
}

// Lo que la página de afiliadxs muestra además de los cupones: por ahora, la
// lista de videos de YouTube. Una sola fila (la crea el backoffice al guardar).
// Va en una tabla propia y NO en `Home` a propósito: `GET /api/home` es público
// y devuelve la fila entera de Home, y la lista sólo la recibe la página
// privada (`GET /api/afiliados/:token`). El link no va en el repo.
model ContenidoAfiliados {
  id        Int      @id @default(autoincrement())
  listaUrl  String   @default("")
  updatedAt DateTime @updatedAt
}
